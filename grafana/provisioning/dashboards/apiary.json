  "annotations": {
    "list": [
      {
        "name": "Anomalie critiche",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-beehive"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "query": "// One region per anomaly: from \"raised\" to \"resolved\", or up to now while still active.\n// Alerts are few, so the whole history is read: an episode may start before the range.\nalerts = from(bucket: \"beehive\")\n  |> range(start: time(v: 0), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alert\" and r.severity == \"critical\")\n  |> filter(fn: (r) => r._field == \"state\" or r._field == \"message\" or r._field == \"raised_at\")\n  |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"hive_id\", \"rule\"])\n  |> sort(columns: [\"_time\"])\n\nclosed = alerts\n  |> filter(fn: (r) => r.state == \"resolved\" and exists r.raised_at)\n  |> map(fn: (r) => ({_time: time(v: r.raised_at), timeEnd: r._time, hive_id: r.hive_id, rule: r.rule, message: r.message}))\n\nactive = alerts\n  |> tail(n: 1)\n  |> filter(fn: (r) => r.state == \"raised\")\n  |> map(fn: (r) => ({_time: r._time, timeEnd: v.timeRangeStop, hive_id: r.hive_id, rule: r.rule, message: r.message}))\n\nunion(tables: [closed, active])\n  |> filter(fn: (r) => r.timeEnd >= v.timeRangeStart)\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, timeEnd: r.timeEnd, title: r.hive_id + \" · \" + (if r.rule == \"weight_drop\" then \"Calo di peso\" else if r.rule == \"inactivity\" then \"Inattività\" else \"Umidità persistente\"), text: r.message, tags: r.hive_id}))\n  |> sort(columns: [\"_time\"])"
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "_time"
          },
          "timeEnd": {
            "source": "field",
            "value": "timeEnd"
          },
          "title": {
            "source": "field",
            "value": "title"
          },
          "text": {
            "source": "field",
            "value": "text"
          },
          "tags": {
            "source": "field",
            "value": "tags"
          }
        }
      },
      {
        "name": "Avvisi",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-beehive"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "query": "// One region per anomaly: from \"raised\" to \"resolved\", or up to now while still active.\n// Alerts are few, so the whole history is read: an episode may start before the range.\nalerts = from(bucket: \"beehive\")\n  |> range(start: time(v: 0), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alert\" and r.severity == \"warning\")\n  |> filter(fn: (r) => r._field == \"state\" or r._field == \"message\" or r._field == \"raised_at\")\n  |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"hive_id\", \"rule\"])\n  |> sort(columns: [\"_time\"])\n\nclosed = alerts\n  |> filter(fn: (r) => r.state == \"resolved\" and exists r.raised_at)\n  |> map(fn: (r) => ({_time: time(v: r.raised_at), timeEnd: r._time, hive_id: r.hive_id, rule: r.rule, message: r.message}))\n\nactive = alerts\n  |> tail(n: 1)\n  |> filter(fn: (r) => r.state == \"raised\")\n  |> map(fn: (r) => ({_time: r._time, timeEnd: v.timeRangeStop, hive_id: r.hive_id, rule: r.rule, message: r.message}))\n\nunion(tables: [closed, active])\n  |> filter(fn: (r) => r.timeEnd >= v.timeRangeStart)\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, timeEnd: r.timeEnd, title: r.hive_id + \" · \" + (if r.rule == \"weight_drop\" then \"Calo di peso\" else if r.rule == \"inactivity\" then \"Inattività\" else \"Umidità persistente\"), text: r.message, tags: r.hive_id}))\n  |> sort(columns: [\"_time\"])"
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "_time"
          },
          "timeEnd": {
            "source": "field",
            "value": "timeEnd"
          },
