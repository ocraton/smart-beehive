      "title": "Stato attuatori",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-beehive"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.hive_id} ${__field.labels.actuator}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5a5f6b"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "#5a5f6b",
                  "index": 0
                },
                "1": {
                  "text": "ON",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beehive"
          },
          "query": "// States are written only when they change: carry the last value before the\n// time range to its start, otherwise a state that did not change would not show up.\nprevious = from(bucket: \"beehive\")\n  |> range(start: time(v: 0), stop: v.timeRangeStart)\n  |> filter(fn: (r) => r._measurement == \"actuator\" and r._field == \"state\")\n  |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> last()\n  |> map(fn: (r) => ({r with _time: v.timeRangeStart}))\n\ncurrent = from(bucket: \"beehive\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator\" and r._field == \"state\")\n  |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n\nunion(tables: [previous, current])\n  |> group(columns: [\"hive_id\", \"actuator\"])\n  |> sort(columns: [\"_time\"])\n  |> keep(columns: [\"_time\", \"_value\", \"hive_id\", \"actuator\"])"
        }
      ]
