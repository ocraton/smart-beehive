          "uid": "influxdb-beehive"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"beehive\", tag: \"hive_id\")",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
