      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beehive"
          },
          "query": "from(bucket: \"beehive\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"reserves\" and r._field == \"actual\")\n    |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> keep(columns: [\"_time\", \"_value\", \"hive_id\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beehive"
          },
          "query": "from(bucket: \"beehive\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"reserves\" and r._field == \"smoothed\")\n    |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> keep(columns: [\"_time\", \"_value\", \"hive_id\"])"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beehive"
          },
          "query": "from(bucket: \"beehive\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forecast_reserves\" and r._field == \"reserves_kg\")\n  |> filter(fn: (r) => r.method == \"linear\")\n    |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> keep(columns: [\"_time\", \"_value\", \"hive_id\"])"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beehive"
          },
          "query": "crit = from(bucket: \"beehive\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"forecast\" and r.kind == \"depletion\" and r._field == \"critical_reserves_kg\")\n  |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> group(columns: [\"hive_id\"])\n  |> last()\n  |> keep(columns: [\"hive_id\", \"_value\"])\n  |> rename(columns: {_value: \"critical\"})\ntimes = from(bucket: \"beehive\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => (r._measurement == \"reserves\" and r._field == \"smoothed\") or r._measurement == \"forecast_reserves\")\n  |> keep(columns: [\"_time\", \"hive_id\"])\n  |> group(columns: [\"hive_id\"])\n  |> unique(column: \"_time\")\njoin(tables: {t: times, c: crit}, on: [\"hive_id\"])\n  |> map(fn: (r) => ({_time: r._time, _value: r.critical, hive_id: r.hive_id}))\n  |> group(columns: [\"hive_id\"])\n  |> sort(columns: [\"_time\"])"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-beehive"
          },
          "query": "from(bucket: \"beehive\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forecast_reserves\" and r._field == \"reserves_kg\")\n  |> filter(fn: (r) => r.method == \"seasonal\")\n    |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> keep(columns: [\"_time\", \"_value\", \"hive_id\"])"
        }
      ]
