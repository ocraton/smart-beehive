  "annotations": {
    "list": [
      {
        "name": "Smielatura ottimale (stimata)",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-beehive"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"beehive\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"forecast\" and r.kind == \"harvest\")\n  |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"hive_id\"])\n  |> sort(columns: [\"_time\"])\n  |> tail(n: 1)\n  |> filter(fn: (r) => exists r.optimal_ts)\n  |> map(fn: (r) => ({_time: time(v: r.optimal_ts * 1000000000), text: \"Ottimale stimata: \" + r.hive_id, title: \"Smielatura ottimale (stimata)\", tags: r.hive_id}))"
        }
      },
      {
        "name": "Smielatura reale",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-beehive"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"beehive\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"forecast\" and r.kind == \"harvest\")\n  |> filter(fn: (r) => contains(value: r.hive_id, set: ${hive_id:json}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"hive_id\"])\n  |> sort(columns: [\"_time\"])\n  |> tail(n: 1)\n  |> filter(fn: (r) => exists r.actual_harvest_ts)\n  |> map(fn: (r) => ({_time: time(v: r.actual_harvest_ts * 1000000000), text: \"Smielatura reale: \" + r.hive_id, title: \"Smielatura reale\", tags: r.hive_id}))"
        }
      }
    ]
  },
  "templating": {
