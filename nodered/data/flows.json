    {
        "id": "c7b0000000000003",
        "type": "function",
        "z": "c7b0000000000001",
        "name": "store config",
        "func": "// apiary/{hive_id}/config\nconst parts = msg.topic.split(\"/\");\nconst c = msg.payload;\nif (parts.length !== 3 || !c || !c.heater || !c.fan_temp || !c.fan_humidity) {\n    return null;\n}\nconst config = flow.get(\"config\") || {};\nconfig[parts[1]] = c;\nflow.set(\"config\", config);\nnode.status({ text: `${parts[1]} heater ${c.heater.on_below}/${c.heater.off_above}` });\nreturn null;",
        "outputs": 1,
