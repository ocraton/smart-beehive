        "type": "function",
        "z": "c8a0000000000001",
        "name": "build sim message",
        "func": "// Sliders send their own field only (partial set), presets the full object, \"Sciamatura\" an event.\nconst hive = flow.get(\"selected\");\nif (!hive) {\n    node.warn(\"no hive selected: nothing sent\");\n    return null;\n}\nif (msg.topic === \"event\") {\n    return { topic: `sim/${hive}/event`, payload: msg.payload };\n}\nlet payload = msg.payload;\nif (msg.topic !== \"preset\") {\n    if (typeof msg.payload !== \"number\") {\n        return null;\n    }\n    payload = { [msg.topic]: msg.topic === \"flight_factor\" ? msg.payload / 100 : msg.payload };\n}\nreturn { topic: `sim/${hive}/perturbation/set`, payload: payload };",
