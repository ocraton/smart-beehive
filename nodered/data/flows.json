    {
        "id": "c7a0000000000006",
        "type": "function",
        "z": "c7a0000000000001",
        "name": "merge + validate",
        "func": "const SECTIONS = [\"heater\", \"fan_temp\", \"fan_humidity\"];\nconst file = msg.payload || {};\nconst defaults = file.defaults || {};\nconst override = (file.hives || {})[msg.hive_id] || {};\n\n// Merge per section, field by field: an override may redefine a single threshold\nconst cfg = {};\nfor (const s of SECTIONS) {\n    cfg[s] = Object.assign({}, defaults[s], override[s]);\n}\n\nconst num = (v) => typeof v === \"number\" && isFinite(v);\nconst valid =\n    num(cfg.heater.on_below) && num(cfg.heater.off_above) &&\n    cfg.heater.on_below < cfg.heater.off_above &&\n    [\"fan_temp\", \"fan_humidity\"].every((s) =>\n        num(cfg[s].on_above) && num(cfg[s].off_below) && cfg[s].off_below < cfg[s].on_above);\n\nif (!valid) {\n    node.warn(`invalid thresholds for ${msg.hive_id}, config not published: ${JSON.stringify(cfg)}`);\n    return null;\n}\nreturn { topic: `apiary/${msg.hive_id}/config`, payload: cfg };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 910,
        "y": 120,
        "wires": [
            [
                "c7a0000000000007"
            ]
