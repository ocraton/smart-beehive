        "func": "// Moves the sliders to the state reported by the selected hive. The sliders have\n// passthrough off, so a value set from here is displayed but never sent back as a \"set\".\nconst hive = (flow.get(\"hives\") || {})[flow.get(\"selected\")] || {};\nconst p = Object.assign({ ext_temp_offset: 0, humidity_offset: 0, flight_factor: 1 }, hive.perturbation);\nreturn [\n    { payload: p.ext_temp_offset },\n    { payload: p.humidity_offset },\n    { payload: Math.round(p.flight_factor * 100) }\n];",
