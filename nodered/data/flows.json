    {
        "id": "c7c0000000000002",
        "type": "function",
        "z": "0e6f1d69908a3eac",
        "name": "to actuator point",
        "func": "// apiary/{hive_id}/actuators/{heater|fan}/state\nconst parts = msg.topic.split(\"/\");\nif (parts.length !== 5 || (msg.payload !== \"ON\" && msg.payload !== \"OFF\")) {\n    return null;\n}\n// The state payload carries no \"ts\": the write time is the best timestamp available\nmsg.payload = [{\n    measurement: \"actuator\",\n    tags:   { hive_id: parts[1], actuator: parts[3] },\n    fields: { state: msg.payload === \"ON\" ? 1.0 : 0.0 },\n    timestamp: new Date()\n}];\nreturn msg;",
        "outputs": 1,
