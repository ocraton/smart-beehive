        "type": "function",
        "z": "0e6f1d69908a3eac",
        "name": "to influx point",
        "func": "const parts = msg.topic.split(\"/\");\nif (parts.length !== 4 || typeof msg.payload.value !== \"number\") {\n    return null;\n}\nmsg.payload = [{\n    measurement: \"telemetry\",\n    tags:   { hive_id: parts[1], sensor: parts[3] },\n    fields: { value: msg.payload.value },\n    timestamp: new Date(msg.payload.ts)\n}];\nreturn msg;",
