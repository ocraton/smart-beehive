    {
        "id": "c8a0000000000014",
        "type": "function",
        "z": "c8a0000000000001",
        "name": "hive state",
        "func": "// One store for everything the console shows, keyed by hive id (flow context \"hives\").\nconst parts = msg.topic.split(\"/\");\nconst id = parts[1];\nconst hives = flow.get(\"hives\") || {};\nconst hive = hives[id] = hives[id] || {};\nlet selected = flow.get(\"selected\") || null;\nlet optionsChanged = false;\nlet syncSliders = false;\n\nif (parts[0] === \"apiary\" && parts.length === 3 && parts[2] === \"status\") {\n    const online = msg.payload === \"online\";\n    optionsChanged = hive.online !== online;\n    hive.online = online;\n} else if (parts[0] === \"apiary\" && parts.length === 5 && parts[4] === \"state\") {\n    hive[parts[3]] = msg.payload;\n} else if (parts[0] === \"apiary\" && parts[2] === \"sensors\") {\n    if ((parts[3] !== \"brood_temp\" && parts[3] !== \"humidity\") || !msg.payload ||\n        typeof msg.payload.value !== \"number\") {\n        return null;\n    }\n    hive[parts[3]] = msg.payload.value;\n} else if (parts[0] === \"sim\" && parts[3] === \"state\" && msg.payload && typeof msg.payload === \"object\") {\n    // The hive's own (retained) answer is the only source of truth for the sliders\n    hive.perturbation = msg.payload;\n    syncSliders = id === selected;\n} else {\n    return null;\n}\nflow.set(\"hives\", hives);\n\nconst online = Object.keys(hives).filter((k) => hives[k].online).sort();\nif (!online.includes(selected)) {\n    selected = online[0] || null;\n    flow.set(\"selected\", selected);\n    optionsChanged = true;\n    syncSliders = true;\n}\n\nconst signed = (v) => (v > 0 ? \"+\" : \"\") + v;\nconst rows = online.map((k) => {\n    const h = hives[k];\n    const p = h.perturbation || {};\n    return {\n        hive: k,\n        ext_temp_offset: p.ext_temp_offset === undefined ? \"?\" : `${signed(p.ext_temp_offset)} °C`,\n        humidity_offset: p.humidity_offset === undefined ? \"?\" : signed(p.humidity_offset),\n        flight_factor: p.flight_factor === undefined ? \"?\" : `${Math.round(p.flight_factor * 100)} %`,\n        heater: h.heater || \"?\",\n        fan: h.fan || \"?\",\n        brood_temp: h.brood_temp === undefined ? \"?\" : `${h.brood_temp.toFixed(1)} °C`,\n        humidity: h.humidity === undefined ? \"?\" : `${h.humidity.toFixed(1)} %`\n    };\n});\n\nreturn [\n    optionsChanged ? { ui_update: { options: online }, payload: selected } : null,\n    syncSliders ? { payload: selected } : null,\n    { payload: rows }\n];",
