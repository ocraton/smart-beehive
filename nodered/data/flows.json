        "id": "c7b0000000000005",
        "type": "function",
        "z": "c7b0000000000001",
        "name": "store confirmed state",
        "func": "// apiary/{hive_id}/actuators/{heater|fan}/state: what the hive CONFIRMED, not what we asked for\nconst parts = msg.topic.split(\"/\");\nif (parts.length !== 5 || (msg.payload !== \"ON\" && msg.payload !== \"OFF\")) {\n    return null;\n}\nconst states = flow.get(\"states\") || {};\nstates[parts[1]] = states[parts[1]] || {};\nstates[parts[1]][parts[3]] = msg.payload;\nflow.set(\"states\", states);\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
