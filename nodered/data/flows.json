    {
        "id": "c7b0000000000007",
        "type": "function",
        "z": "c7b0000000000001",
        "name": "decide",
        "func": "// apiary/{hive_id}/sensors/{sensor}\nconst parts = msg.topic.split(\"/\");\nif (parts.length !== 4 || !msg.payload || typeof msg.payload.value !== \"number\") {\n    return null;\n}\nconst hive = parts[1];\nconst sensor = parts[3];\nif (sensor !== \"brood_temp\" && sensor !== \"humidity\") {\n    return null;\n}\n\nconst values = flow.get(\"values\") || {};\nconst v = values[hive] = values[hive] || {};\nv[sensor] = msg.payload.value;\nflow.set(\"values\", values);\n\nconst cfg = (flow.get(\"config\") || {})[hive];\nif (!cfg) {\n    const warned = context.get(\"warned\") || {};\n    if (!warned[hive]) {\n        warned[hive] = true;\n        context.set(\"warned\", warned);\n        node.warn(`no config for ${hive} yet: control loop idle`);\n    }\n    return null;\n}\n\nconst confirmed = (flow.get(\"states\") || {})[hive] || {};\nconst allNeeds = flow.get(\"needs\") || {};\nconst needs = allNeeds[hive] = allNeeds[hive] || {};\n\n// Hysteresis with memory: a need changes only when the value leaves the band.\n// After a Node-RED restart the memory is rebuilt from the confirmed actuator state;\n// if that is unknown too, the need stays undefined until the value leaves the band.\nfunction update(name, actuator, value, turnsOn, turnsOff) {\n    if (needs[name] === undefined && confirmed[actuator] !== undefined) {\n        needs[name] = confirmed[actuator] === \"ON\";\n    }\n    if (value === undefined) {\n        return;\n    }\n    if (needs[name] !== true && turnsOn(value)) {\n        needs[name] = true;\n    } else if (needs[name] !== false && turnsOff(value)) {\n        needs[name] = false;\n    }\n}\nupdate(\"heaterNeed\", \"heater\", v.brood_temp,\n    (t) => t < cfg.heater.on_below, (t) => t > cfg.heater.off_above);\nupdate(\"fanTempNeed\", \"fan\", v.brood_temp,\n    (t) => t > cfg.fan_temp.on_above, (t) => t < cfg.fan_temp.off_below);\nupdate(\"fanHumNeed\", \"fan\", v.humidity,\n    (h) => h > cfg.fan_humidity.on_above, (h) => h < cfg.fan_humidity.off_below);\nflow.set(\"needs\", allNeeds);\n\n// Desired state. Heating wins over ventilation: a running fan would waste the heat.\nconst heater = needs.heaterNeed;\nlet fan;\nif (heater === true) {\n    fan = false;\n} else if (heater === false) {\n    if (needs.fanTempNeed === true || needs.fanHumNeed === true) {\n        fan = true;\n    } else if (needs.fanTempNeed === false && needs.fanHumNeed === false) {\n        fan = false;\n    }\n}\n\n// Command only what differs from the confirmed state. Nothing is retried on a timer:\n// while the hive has not confirmed, the next reading emits the command again.\nconst sent = context.get(\"sent\") || {};\nconst out = [];\nfor (const [actuator, want] of [[\"heater\", heater], [\"fan\", fan]]) {\n    if (want === undefined) {\n        continue;\n    }\n    const cmd = want ? \"ON\" : \"OFF\";\n    const key = `${hive}/${actuator}`;\n    if (confirmed[actuator] === cmd) {\n        delete sent[key];\n        continue;\n    }\n    // brood_temp and humidity of the same tick share \"ts\": one command per tick is enough\n    if (sent[key] && sent[key].cmd === cmd && sent[key].ts === msg.payload.ts) {\n        continue;\n    }\n    sent[key] = { cmd: cmd, ts: msg.payload.ts };\n    out.push({ topic: `apiary/${hive}/actuators/${actuator}/cmd`, payload: cmd });\n}\ncontext.set(\"sent\", sent);\n\nconst onOff = (b) => (b === undefined ? \"?\" : b ? \"ON\" : \"OFF\");\nconst t = v.brood_temp === undefined ? \"?\" : v.brood_temp.toFixed(1);\nconst h = v.humidity === undefined ? \"?\" : v.humidity.toFixed(0);\nnode.status({\n    fill: heater ? \"red\" : fan ? \"blue\" : \"grey\",\n    shape: \"dot\",\n    text: `${hive} ${t}°C ${h}% heater ${onOff(heater)} fan ${onOff(fan)}`\n});\nreturn [out];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 260,
        "wires": [
            [
                "c7b0000000000008",
                "c7b0000000000009"
            ]
        ]
