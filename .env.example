# Copy to .env (git-ignored) and replace the placeholder values.
# InfluxDB only reads these on the FIRST start (empty volume): changing them
# later has no effect unless you remove the influxdb_data/influxdb_config volumes.

INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-please
INFLUXDB_ORG=beehive
INFLUXDB_BUCKET=beehive
# Admin API token; generate one with: openssl rand -hex 32
INFLUXDB_TOKEN=replace-with-a-long-random-token

TZ=Europe/Rome
